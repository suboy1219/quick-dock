<Window x:Class="QuickDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickDock"
        Width="320"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-10000"
        Top="-10000"
        Visibility="Collapsed"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="LauncherItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A5B8CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemMouseLeftButtonUp" />
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="10" CornerRadius="12"
            Background="#F218181D" BorderBrush="#30FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <DockPanel Margin="12,10,12,10">
            <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4C8DFF" Offset="0" />
                                <GradientStop Color="#FF8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <UniformGrid Rows="2" Columns="2" Width="8" Height="8" HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                            <Border Background="White" CornerRadius="0.5" Margin="0,0,1,1" />
                            <Border Background="White" CornerRadius="0.5" Margin="1,0,0,1" />
                            <Border Background="White" CornerRadius="0.5" Margin="0,1,1,0" />
                            <Border Background="White" CornerRadius="0.5" Margin="1,1,0,0" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="快速启动" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="HotkeyHint" FontSize="9.5" HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>

            <Grid DockPanel.Dock="Bottom" Margin="2,7,2,0">
                <TextBlock Text="1-9 快速启动 · Enter 打开 · Esc 关闭" FontSize="9.5"
                           Foreground="#FF6A6A78" />
                <TextBlock x:Name="CountHint" FontSize="9.5" HorizontalAlignment="Right"
                           Foreground="#FF6A6A78" />
            </Grid>

            <Grid>
                <ListBox x:Name="AppsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MaxHeight="380"
                         SelectionMode="Single"
                         FocusVisualStyle="{x:Null}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource LauncherItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="20" Height="20"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="#FFEDEDF2" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyState" Visibility="Collapsed" Text="还没有可启动的应用"
                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,16" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
