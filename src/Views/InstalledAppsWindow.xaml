<Window x:Class="QuickDock.Views.InstalledAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加已安装程序"
        Width="620"
        Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="14" Background="#FF15151A" CornerRadius="14"
            BorderBrush="#30FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,14,0" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="添加已安装程序" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" FontSize="10" Margin="0,3,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Content="✕" Width="32" Height="28" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource GhostButton}" Click="OnCancel" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Height="34" Style="{StaticResource TextBoxStyle}"
                                 TextChanged="OnSearchChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索程序名称…" FontSize="12"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="#FF66667A" IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="1" Content="全选" Height="34" Padding="12,0"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="OnSelectAll" />
                    <Button Grid.Column="2" Content="全不选" Height="34" Padding="12,0"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="OnSelectNone" />
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                        Padding="6">
                    <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#10FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplayPath}" FontSize="9"
                                                   Margin="0,2,0,0"
                                                   Foreground="#FF62626F"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsHitTestVisible="False" Focusable="False"
                                              Style="{StaticResource CheckBoxStyle}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0,20,0">
                <TextBlock x:Name="SelectedCountText" Text="已选 0 项" FontSize="10.5"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Padding="18,7"
                            Click="OnCancel" />
                    <Button x:Name="AddButton" Content="添加选中" Style="{StaticResource PrimaryButton}"
                            Padding="20,7" Margin="10,0,0,0" IsEnabled="False" Click="OnAdd" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
