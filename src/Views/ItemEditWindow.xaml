<Window x:Class="QuickDock.Views.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑应用"
        Width="500"
        Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="16" Background="#FF15151A" CornerRadius="16"
            BorderBrush="#30FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <Grid Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock x:Name="HeaderText" Text="添加应用" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="32" Height="28" Style="{StaticResource GhostButton}" Padding="0"
                        Click="OnCancel" />
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="显示名称" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="NameBox" Style="{StaticResource TextBoxStyle}" Margin="0,6,0,0"
                         MaxLength="60" />

                <TextBlock Text="启动路径" FontSize="12" Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Style="{StaticResource TextBoxStyle}"
                             TextChanged="OnPathChanged" />
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                            Padding="12,8" Margin="8,0,0,0" Click="OnBrowseFile" />
                </Grid>

                <TextBlock Text="启动参数（可选）" FontSize="12" Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="ArgsBox" Style="{StaticResource TextBoxStyle}" Margin="0,6,0,0" />

                <TextBlock Text="工作目录（可选）" FontSize="12" Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkDirBox" Style="{StaticResource TextBoxStyle}" />
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                            Padding="12,8" Margin="8,0,0,0" Click="OnBrowseFolder" />
                </Grid>

                <TextBlock Text="支持 exe、快捷方式、文档、文件夹、网址（https://）以及 ms-settings: 等 shell 路径。"
                           FontSize="10.5" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="#FF5C5C6E" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="取消" Style="{StaticResource GhostButton}" Padding="20,8"
                        Click="OnCancel" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Padding="28,8"
                        Margin="10,0,0,0" Click="OnConfirm" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
